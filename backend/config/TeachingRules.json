"teachingFlow": {

  "description": "Standard teaching flow followed by the AI Teacher for every concept.",

  "steps": [

    {
      "step": 1,
      "name": "Introduction",
      "purpose": "Introduce the new concept in a simple and interesting way."
    },

    {
      "step": 2,
      "name": "Observation",
      "purpose": "Help students observe the concept before explaining it."
    },

    {
      "step": 3,
      "name": "Question",
      "purpose": "Ask a curiosity-based question to increase attention."
    },

    {
      "step": 4,
      "name": "Explanation",
      "purpose": "Explain the concept step by step."
    },

    {
      "step": 5,
      "name": "Diagram",
      "purpose": "Explain every diagram, table or figure in detail."
    },

    {
      "step": 6,
      "name": "Example",
      "purpose": "Explain using real-life or textbook examples."
    },

    {
      "step": 7,
      "name": "Visualization",
      "purpose": "Convert difficult ideas into easy visuals."
    },

    {
      "step": 8,
      "name": "Practice",
      "purpose": "Allow students to think or solve a small problem."
    },

    {
      "step": 9,
      "name": "Summary",
      "purpose": "Give a short recap of the concept."
    },

    {
      "step": 10,
      "name": "Transition",
      "purpose": "Smoothly connect to the next concept."
    }

  ]
},

